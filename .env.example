# Copy to .env and fill in.
GROQ_API_KEY=
# Optional extra keys, same model, each from a different Groq account (used when one runs out)
GROQ_API_KEY_BACKUP=
GROQ_API_KEY_BACKUP_2=
GROQ_API_KEY_BACKUP_3=
LLM_PRIMARY_MODEL=openai/gpt-oss-120b

# Local services: use long random values
POSTGRES_PASSWORD=
S3_ACCESS_KEY=docketpilot
S3_SECRET_KEY=
JWT_SECRET=

# Used when running Python on this machine (outside Docker); same password as POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://docketpilot:<POSTGRES_PASSWORD>@127.0.0.1:5432/docketpilot
TEST_DATABASE_URL=postgresql+asyncpg://docketpilot:<POSTGRES_PASSWORD>@127.0.0.1:5432/docketpilot_test

# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_KEY=

# Search index of all judgment passages (built with the GPU indexer)
QDRANT_COLLECTION=chunks_all

# Google sign-in (optional): OAuth client id, see README
GOOGLE_CLIENT_ID=
